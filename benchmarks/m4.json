          {"op":"apply","expected_rev":1,"edits":[{"kind":"set_field","target":{"kind":"resource","id":"action.abilities"},"field":"/abilities/slash2/dodge_window","value":{"start":25,"end":70}}]},
          {"op":"verify"}
        ]
      }
    },
