          {"op":"apply","expected_rev":1,"edits":[{"kind":"set_field","target":{"kind":"rule","id":"quest.complete"},"field":"/when/conditions/1/right/value","value":4},{"kind":"set_field","target":{"kind":"choice","node":"quest.active","id":"assault"},"field":"/when/right/value","value":4}]},
