      "lumi": {"initial":"idle","states":{
          "idle":{"action":{"kind":"stop"},"clip":"idle"},
          "stroll":{"action":{"kind":"wander","radius":3,"speed":0.9},"clip":"walk"},
          "greet":{"action":{"kind":"face","tag":"player"},"clip":"wave","clip_loop":false,"emit":"near_lumi"},
          "bye":{"action":{"kind":"stop"},"clip":"idle","emit":"left_lumi"}
        },
        "transitions":[
          {"from":"idle","to":"greet","when":{"kind":"near","tag":"player","within":2.4}},
          {"from":"stroll","to":"greet","when":{"kind":"near","tag":"player","within":2.4}},
          {"from":"idle","to":"stroll","when":{"kind":"chance","per_tick":0.004}},
          {"from":"stroll","to":"idle","when":{"kind":"in_state_ticks","ticks":720}},
          {"from":"greet","to":"bye","when":{"kind":"far","tag":"player","beyond":3.2}},
          {"from":"bye","to":"idle","when":{"kind":"always"}}
        ]},
      "shopkeeper": {"initial":"idle","states":{
          "idle":{"action":{"kind":"stop"},"clip":"idle"},
          "serve":{"action":{"kind":"face","tag":"player"},"clip":"talk","emit":"near_rin"},
          "bye":{"action":{"kind":"stop"},"clip":"bow","clip_loop":false,"emit":"left_rin"}
        },
        "transitions":[
          {"from":"idle","to":"serve","when":{"kind":"near","tag":"player","within":2.6}},
          {"from":"serve","to":"bye","when":{"kind":"far","tag":"player","beyond":3.4}},
          {"from":"bye","to":"idle","when":{"kind":"in_state_ticks","ticks":170}}
        ]},
      "stroller": {"initial":"stroll","states":{
          "stroll":{"action":{"kind":"wander","radius":5,"speed":1.1},"clip":"walk"},
          "rest":{"action":{"kind":"stop"},"clip":"idle"},
          "dance":{"action":{"kind":"stop"},"clip":"dance"},
          "pose":{"action":{"kind":"stop"},"clip":"pose"},
          "wave":{"action":{"kind":"face","tag":"player"},"clip":"wave","clip_loop":false}
        },
        "transitions":[
          {"from":"stroll","to":"wave","when":{"kind":"near","tag":"player","within":1.8}},
          {"from":"wave","to":"stroll","when":{"kind":"in_state_ticks","ticks":200}},
          {"from":"stroll","to":"rest","when":{"kind":"in_state_ticks","ticks":900}},
          {"from":"rest","to":"dance","when":{"kind":"chance","per_tick":0.004}},
          {"from":"rest","to":"pose","when":{"kind":"chance","per_tick":0.004}},
          {"from":"rest","to":"stroll","when":{"kind":"in_state_ticks","ticks":720}},
          {"from":"dance","to":"stroll","when":{"kind":"in_state_ticks","ticks":960}},
          {"from":"pose","to":"stroll","when":{"kind":"in_state_ticks","ticks":480}}
        ]}
    }},
