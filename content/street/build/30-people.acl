# Axiom Street, stage 3: pedestrians on sidewalk paths, a nav agent that crosses on red, NPC Ming.
# Person: primitive body built in the Inspector (front = +Z), saved as a prefab.
create cube id=ped/n1 at=-20,0,-5
set ped/n1 render.mesh/parts [{"transform":{"position":[0,0.45,0],"scale":[0.34,0.9,0.22]},"color":[0.16,0.17,0.22]},{"transform":{"position":[0,1.17,0],"scale":[0.44,0.58,0.26]},"color":[0.3,0.55,0.75]},{"transform":{"position":[0,1.6,0],"scale":[0.26,0.28,0.26]},"color":[0.93,0.78,0.65]},{"transform":{"position":[0,1.76,-0.02],"scale":[0.28,0.08,0.28]},"color":[0.15,0.1,0.08]},{"transform":{"position":[0,1.6,0.14],"scale":[0.06,0.06,0.03]},"color":[0.8,0.62,0.5]}]
prefab create person from ped/n1
instantiate person id=ped/n2 at=0,0,-5
instantiate person id=ped/n3 at=15,0,-5
instantiate person id=ped/s1 at=0,0,5
instantiate person id=ped/s2 at=-15,0,5
set ped/n2 render.mesh/parts/1/color [0.85,0.35,0.45]
set ped/n3 render.mesh/parts/1/color [0.9,0.8,0.3]
set ped/s1 render.mesh/parts/1/color [0.5,0.4,0.75]
set ped/s2 render.mesh/parts/1/color [0.85,0.5,0.25]
rename ped/n1 "行人 · 藍外套"
rename ped/n2 "行人 · 粉紅毛衣"
rename ped/n3 "行人 · 黃雨衣"
rename ped/s1 "行人 · 紫襯衫"
rename ped/s2 "行人 · 橘夾克"

# Sidewalk loops: out along the curb side, back along the building side.
create path id=walk/north at=0,0,0
set walk/north path.spline/points [[-34,0,-4.9],[34,0,-4.9],[34,0,-6.4],[-34,0,-6.4]]
create path id=walk/south at=0,0,0
set walk/south path.spline/points [[34,0,4.9],[-34,0,4.9],[-34,0,6.4],[34,0,6.4]]
follow entities[id=ped/n1,id=ped/n2,id=ped/n3] walk/north speed=1.3
follow entities[id=ped/s1,id=ped/s2] walk/south speed=1.1
set ped/n2 path.follow/speed 1.05
set ped/n3 path.follow/offset 0.35
set ped/s2 path.follow/speed 1.4
set entities[id=ped/n1,id=ped/n2,id=ped/n3,id=ped/s1,id=ped/s2] path.follow/turn_rate 360

# A pedestrian who uses the zebra crossing: nav agent, sent across by rules when the light turns red.
instantiate person id=ped/x at=-0.6,0,5.6
rename ped/x "過馬路的行人"
set ped/x render.mesh/parts/1/color [0.95,0.95,0.95]
nav ped/x agent speed=2.2 radius=0.3
set resources[id=behavior.program] variables/ped_side "south"
set resources[id=behavior.program] events/ped_go_north {"fields":{}}
set resources[id=behavior.program] events/ped_go_south {"fields":{}}

# NPC Ming waits at the bus stop; talking to him uses the interact component (E).
instantiate person id=npc/ming at=-10,0,7.6
rename npc/ming "阿明 · 等公車的人"
set npc/ming core.transform/rotation [0,1,0,0]
set npc/ming render.mesh/parts/1/color [0.3,0.65,0.4]
interact npc/ming event=talk_ming prompt=talk_ming range=2.4
