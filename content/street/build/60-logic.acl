# Axiom Street, stage 6: behaviour rules, native bindings, dialogue and HUD (Resource inspector fields).
set resources[id=behavior.program] variables/red false
set resources[id=behavior.program] variables/location "loc_street"
set resources[id=behavior.program] events/light_green {"fields":{}}
set resources[id=behavior.program] events/light_yellow {"fields":{}}
set resources[id=behavior.program] events/light_red {"fields":{}}
set resources[id=behavior.program] events/pause_car_a {"fields":{}}
set resources[id=behavior.program] events/pause_car_b {"fields":{}}
set resources[id=behavior.program] events/pause_car_c {"fields":{}}

# Rules. A toggle emits a second event and changes the variable there (rules of one event run in order).
set resources[id=behavior.program] rules [{"id":"signal-green-done","event":"cycle_green","actions":[{"kind":"delay","ticks":720,"event":"light_yellow"}]},{"id":"signal-yellow-done","event":"cycle_yellow","actions":[{"kind":"delay","ticks":240,"event":"light_red"}]},{"id":"signal-red-done","event":"cycle_red","actions":[{"kind":"delay","ticks":720,"event":"light_green"}]},{"id":"signal-red","event":"light_red","actions":[{"kind":"set","variable":"red","value":{"kind":"literal","value":true}}]},{"id":"signal-green","event":"light_green","actions":[{"kind":"set","variable":"red","value":{"kind":"literal","value":false}}]},{"id":"car-a-red","event":"car_a_line","when":{"kind":"eq","left":{"kind":"variable","id":"red"},"right":{"kind":"literal","value":true}},"actions":[{"kind":"emit","event":"pause_car_a"}]},{"id":"car-b-red","event":"car_b_line","when":{"kind":"eq","left":{"kind":"variable","id":"red"},"right":{"kind":"literal","value":true}},"actions":[{"kind":"emit","event":"pause_car_b"}]},{"id":"car-c-red","event":"car_c_line","when":{"kind":"eq","left":{"kind":"variable","id":"red"},"right":{"kind":"literal","value":true}},"actions":[{"kind":"emit","event":"pause_car_c"}]},{"id":"ped-cross-north","event":"light_red","when":{"kind":"eq","left":{"kind":"variable","id":"ped_side"},"right":{"kind":"literal","value":"south"}},"actions":[{"kind":"emit","event":"ped_go_north"}]},{"id":"ped-cross-south","event":"light_red","when":{"kind":"eq","left":{"kind":"variable","id":"ped_side"},"right":{"kind":"literal","value":"north"}},"actions":[{"kind":"emit","event":"ped_go_south"}]},{"id":"ped-now-north","event":"ped_go_north","actions":[{"kind":"set","variable":"ped_side","value":{"kind":"literal","value":"north"}}]},{"id":"ped-now-south","event":"ped_go_south","actions":[{"kind":"set","variable":"ped_side","value":{"kind":"literal","value":"south"}}]},{"id":"door-open","event":"door_use","when":{"kind":"eq","left":{"kind":"variable","id":"door_open"},"right":{"kind":"literal","value":false}},"actions":[{"kind":"emit","event":"door_opening"}]},{"id":"door-close","event":"door_use","when":{"kind":"eq","left":{"kind":"variable","id":"door_open"},"right":{"kind":"literal","value":true}},"actions":[{"kind":"emit","event":"door_closing"}]},{"id":"door-opened","event":"door_opening","actions":[{"kind":"set","variable":"door_open","value":{"kind":"literal","value":true}},{"kind":"set","variable":"door_hint","value":{"kind":"literal","value":false}}]},{"id":"door-closed","event":"door_closing","actions":[{"kind":"set","variable":"door_open","value":{"kind":"literal","value":false}}]},{"id":"doorway-closed","event":"doorway_enter","when":{"kind":"eq","left":{"kind":"variable","id":"door_open"},"right":{"kind":"literal","value":false}},"actions":[{"kind":"set","variable":"door_hint","value":{"kind":"literal","value":true}},{"kind":"emit","event":"door_blocked"}]},{"id":"cafe-in","event":"enter_cafe","actions":[{"kind":"set","variable":"location","value":{"kind":"literal","value":"loc_cafe"}}]},{"id":"cafe-out","event":"leave_cafe","actions":[{"kind":"set","variable":"location","value":{"kind":"literal","value":"loc_street"}},{"kind":"go_to","node":"street"}]},{"id":"talk-ming","event":"talk_ming","actions":[{"kind":"go_to","node":"ming"}]},{"id":"talk-barista","event":"talk_barista","actions":[{"kind":"go_to","node":"barista"}]}]

# Native calls per event, written whole in one statement (`append` adds a single binding; a `set`
# that drops an existing item, e.g. the tween play_on binding, prints a warning).
set resources[id=runtime.bindings] events [{"event":"door_opening","calls":[{"kind":"call","capability":"tween","action":"play","args":{"id":"cafe/door","clip":"open"}},{"kind":"call","capability":"audio","action":"play","args":{"id":"cafe/door","restart":true}}]},{"event":"door_closing","calls":[{"kind":"call","capability":"tween","action":"play","args":{"id":"cafe/door","clip":"open","reverse":true}},{"kind":"call","capability":"audio","action":"play","args":{"id":"cafe/door","restart":true}}]},{"event":"door_blocked","calls":[{"kind":"call","capability":"nav","action":"go","args":{"id":"hero","point":[11,0,-6.4]}}]},{"event":"enter_cafe","calls":[{"kind":"call","capability":"audio","action":"play","args":{"id":"cafe/radio"}},{"kind":"call","capability":"camera","action":"follow.set","args":{"id":"camera","distance":5,"pitch":30}}]},{"event":"leave_cafe","calls":[{"kind":"call","capability":"audio","action":"stop","args":{"id":"cafe/radio"}},{"kind":"call","capability":"camera","action":"follow.set","args":{"id":"camera","distance":7,"pitch":22}}]},{"event":"light_yellow","calls":[{"kind":"call","capability":"tween","action":"play","args":{"id":"signal","clip":"yellow"}}]},{"event":"light_red","calls":[{"kind":"call","capability":"tween","action":"play","args":{"id":"signal","clip":"red"}}]},{"event":"light_green","calls":[{"kind":"call","capability":"tween","action":"play","args":{"id":"signal","clip":"green"}},{"kind":"call","capability":"path","action":"resume","args":{"id":"car/a"}},{"kind":"call","capability":"path","action":"resume","args":{"id":"car/b"}},{"kind":"call","capability":"path","action":"resume","args":{"id":"car/c"}}]},{"event":"pause_car_a","calls":[{"kind":"call","capability":"path","action":"pause","args":{"id":"car/a"}}]},{"event":"pause_car_b","calls":[{"kind":"call","capability":"path","action":"pause","args":{"id":"car/b"}}]},{"event":"pause_car_c","calls":[{"kind":"call","capability":"path","action":"pause","args":{"id":"car/c"}}]},{"event":"ped_go_north","calls":[{"kind":"call","capability":"nav","action":"go","args":{"id":"ped/x","point":[0.6,0,-5.6]}}]},{"event":"ped_go_south","calls":[{"kind":"call","capability":"nav","action":"go","args":{"id":"ped/x","point":[-0.6,0,5.6]}}]}]

# Dialogue (narrative.graph) and HUD (ui.document).
set resources[id=ui.document] catalogs/zh-TW {"title":"AXIOM STREET · 黃昏街口","street":"街道","hub":"左鍵點地面走路 · Z / C 轉視角 · R / F 拉近拉遠 · 靠近人或門按 E","loc_street":"位置:黃昏街口","loc_cafe":"你進入了咖啡廳","notice_closed":"門關著。先按 E 開門。","coffee":"手上:一杯熱拿鐵","talk_ming":"和阿明說話","talk_barista":"和咖啡師小雨說話","door_prompt":"開門 / 關門","ming":"阿明 · 等公車的人","ming_hello":"傍晚好!這條街的紅綠燈剛換新的,車子都會乖乖停在白線前。","ming_ask_cafe":"附近有咖啡廳嗎?","ming_cafe":"對街那間掛粉紅招牌的就是。門平常關著,走到門口按 E 就能打開。","ming_ask_light":"車子真的會等紅燈?","ming_light":"紅燈時車子停在白線前,綠燈才走。過馬路記得走斑馬線,那位白衣服的先生每次紅燈都會過去。","back":"還有別的問題","bye":"再見","barista":"小雨 · 咖啡師","barista_hello":"歡迎光臨!今天想喝點什麼?","barista_latte":"一杯熱拿鐵","barista_done":"拿鐵好了,小心燙!外面天快黑了,路上小心。","barista_again":"還想再點一杯?今天就先一杯吧~","thanks":"謝謝"}
set resources[id=narrative.graph] nodes [{"id":"street","speaker":"street","text":"hub"},{"id":"ming","speaker":"ming","text":"ming_hello","choices":[{"id":"cafe","text":"ming_ask_cafe","next":"ming_cafe"},{"id":"light","text":"ming_ask_light","next":"ming_light"},{"id":"bye","text":"bye","next":"street"}]},{"id":"ming_cafe","speaker":"ming","text":"ming_cafe","choices":[{"id":"back","text":"back","next":"ming"},{"id":"bye","text":"bye","next":"street"}]},{"id":"ming_light","speaker":"ming","text":"ming_light","choices":[{"id":"back","text":"back","next":"ming"},{"id":"bye","text":"bye","next":"street"}]},{"id":"barista","speaker":"barista","text":"barista_hello","choices":[{"id":"latte","text":"barista_latte","when":{"kind":"eq","left":{"kind":"variable","id":"has_coffee"},"right":{"kind":"literal","value":false}},"actions":[{"kind":"set","variable":"has_coffee","value":{"kind":"literal","value":true}}],"next":"barista_done"},{"id":"bye","text":"bye","next":"street"}]},{"id":"barista_done","speaker":"barista","text":"barista_done","choices":[{"id":"thanks","text":"thanks","next":"street"}]}]
set resources[id=ui.document] widgets [{"kind":"text","id":"title","binding":{"kind":"key","id":"title"}},{"kind":"text","id":"location","binding":{"kind":"localized_variable","id":"location"}},{"kind":"text","id":"coffee","binding":{"kind":"key","id":"coffee"},"when":{"kind":"eq","left":{"kind":"variable","id":"has_coffee"},"right":{"kind":"literal","value":true}}},{"kind":"text","id":"prompt","binding":{"kind":"prompt"}},{"kind":"text","id":"notice","binding":{"kind":"key","id":"notice_closed"},"when":{"kind":"eq","left":{"kind":"variable","id":"door_hint"},"right":{"kind":"literal","value":true}}},{"kind":"text","id":"speaker","binding":{"kind":"speaker"}},{"kind":"text","id":"line","binding":{"kind":"line"}},{"kind":"choices","id":"choices"}]
set resources[id=ui.document] regions {"title":"top_left","location":"top_left","coffee":"top_left","prompt":"top","notice":"top","speaker":"bottom","line":"bottom","choices":"bottom"}
set resources[id=ui.document] styles {"title":"heading","location":"value","notice":"banner"}
set resources[id=ui.document] chrome "compact"
# Save / load is refused by trigger, path, nav, tween, audio and camera systems (GAP-17); hide those buttons.
set resources[id=ui.document] session_controls false
