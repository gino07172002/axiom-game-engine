    {"id":"beacon","components":{"core.transform":{"position":[0,1,0],"scale":[0.4,3,0.4]},"render.mesh":{"parts":[{"color":[0.15,0.85,0.75],"emission":0.4}]}}},
    {"id":"workbench","tags":["investigate"],"components":{"core.transform":{"position":[0,0,0],"scale":[6,0.6,3]},"render.mesh":{"parts":[{"color":[0.18,0.3,0.34],"grid":true}]}}},
    {"id":"key-case","components":{"core.transform":{"position":[0,0.7,0],"scale":[0.7,0.3,0.7]},"render.mesh":{"parts":[{"color":[1,0.65,0.2],"emission":0.3}]}}},
    {"id":"camera","components":{"core.transform":{"position":[0,5,12],"rotation":[-0.19509032,0,0,0.9807853]},"render.camera":{"projection":{"kind":"perspective","fov_degrees":55},"near":0.1,"far":100,"viewport":[0,0,1,1],"active":true}}}
  ],
  "scenes":[
