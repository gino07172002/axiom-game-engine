        {"kind":"text","id":"dialogue","binding":{"kind":"line"}},
        {"kind":"text","id":"inventory","binding":{"kind":"key","id":"inventory"}},
        {"kind":"progress","id":"progress","variable":"clues","max":1},
        {"kind":"text","id":"chapter","binding":{"kind":"localized_variable","id":"chapter"}},
        {"kind":"choices","id":"choices"}
      ]
    }
  }
