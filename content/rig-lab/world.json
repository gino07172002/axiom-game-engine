{
  "schema_version": 2,
  "id": "rig-lab",
  "title": "Rig Lab / spring bones, IK sockets, look-at",
  "capabilities": {"animation":1,"core":1,"render":1},
  "systems": ["animation.evaluate"],
  "entities": [
    {"id":"puppet/a","label":"Swaying puppet (ponytail spring, looks at the camera)","components":{
      "core.transform":{"position":[-0.2,0,0]},
      "animation.player":{"asset":"puppet","clip":"sway"},
      "animation.spring":{
        "chains":{"ponytail":{"root":"hair.0","stiffness":1.2,"drag":0.3,"gravity":[0,-1.5,0],"radius":0.035}},
        "colliders":{"head":{"bone":"head","offset":[0,0.13,0],"radius":0.14},"back":{"bone":"body","offset":[0,0.2,0],"tail":[0,0.45,0],"radius":0.11}}
      },
      "animation.look_at":{"chains":{"gaze":{"bones":[{"bone":"neck","weight":0.35},{"bone":"head","weight":0.65}],"target":{"kind":"camera"},"max_yaw":70,"max_pitch":25}}}
    }},
    {"id":"puppet/b","label":"Hand-holding puppet (IK socket on A's left hand, looks at A)","components":{
      "core.transform":{"position":[0.3,0,0]},
      "animation.player":{"asset":"puppet","ik":{"hand":{"root":"upper.R","middle":"fore.R","end":"hand.R","target":[-0.21,0.45,0.1],"pole":[-0.6,0.8,-0.6],"socket":{"entity":"puppet/a","bone":"hand.L","offset":[0.05,0.14,0.06]}}}},
      "animation.spring":{
        "chains":{"ponytail":{"root":"hair.0","stiffness":1.2,"drag":0.3,"gravity":[0,-1.5,0],"radius":0.035}},
        "colliders":{"head":{"bone":"head","offset":[0,0.13,0],"radius":0.14}}
      },
      "animation.look_at":{"chains":{"gaze":{"bones":[{"bone":"neck","weight":0.35},{"bone":"head","weight":0.65}],"target":{"kind":"entity","entity":"puppet/a","bone":"head","offset":[0,0.12,0.1]},"max_yaw":80,"max_pitch":30,"smoothing":0.25}}}
    }},
    {"id":"camera/main","label":"Camera","components":{
      "core.transform":{"position":[0.9,1.35,2.6],"rotation":[-0.0436,0.1736,0.0077,0.9838]},
      "render.camera":{"projection":{"kind":"perspective","fov_degrees":40},"near":0.05,"far":40,"viewport":[0,0,1,1],"active":true}
    }},
    {"id":"stage/floor","label":"Floor","components":{
      "core.transform":{"position":[0,-0.05,-0.4],"scale":[6,0.1,5]},
      "render.mesh":{"parts":[{"color":[0.12,0.13,0.16],"grid":true}]}
    }},
    {"id":"stage/backdrop","label":"Backdrop","components":{
      "core.transform":{"position":[0,1.4,-1.6]},
      "render.mesh":{"parts":[{"transform":{"scale":[6,2.8,0.1]},"color":[0.82,0.84,0.88]}]}
    }}
  ],
  "resources": {
    "animation.library":{"assets":{"puppet":{"path":"puppet.glb"}}},
    "render.settings":{"accent":[1,0.45,0.15],"shadow_extent":6}
  }
}
