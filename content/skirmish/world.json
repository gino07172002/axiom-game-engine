{
 "schema_version":2,"id":"skirmish","title":"Skirmish / Data-only Combat",
 "capabilities":{"core":1,"render":1,"fsm":1,"behavior":1},"systems":["fsm.step","behavior.execute"],
 "prefabs":{
  "grunt":{"components":{"core.transform":{},"core.health":{"value":60,"max":60},"fsm.agent":{"machine":"grunt"},"render.mesh":{"parts":[{"color":[0.85,0.25,0.25]}]}}}
 },
 "entities":[
  {"id":"hero","tags":["hero"],"components":{"core.transform":{"position":[-12,0.5,0]},"core.health":{"value":100,"max":100},"fsm.agent":{"machine":"hero"},"render.mesh":{"parts":[{"color":[0.2,0.6,0.95]}]}}},
  {"id":"enemy/0","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[6,0.5,-1.5]}}},
  {"id":"enemy/1","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[8,0.5,0]}}},
  {"id":"enemy/2","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[10,0.5,1.5]}}},
  {"id":"enemy/3","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[12,0.5,-1.5]}}},
  {"id":"enemy/4","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[14,0.5,0]}}},
  {"id":"enemy/5","prefab":"grunt","tags":["enemy"],"components":{"core.transform":{"position":[16,0.5,1.5]}}},
  {"id":"floor","components":{"core.transform":{"position":[0,-0.3,0],"scale":[44,0.5,14]},"render.mesh":{"parts":[{"color":[0.15,0.19,0.23],"grid":true}]}}},
  {"id":"camera","components":{"core.transform":{"position":[0,20,22],"rotation":[-0.3826834,0,0,0.9238795]},"render.camera":{"projection":{"kind":"perspective","fov_degrees":60},"near":0.1,"far":200,"viewport":[0,0,1,1],"active":true}}}
 ],
 "resources":{
  "render.settings":{"accent":[0.95,0.3,0.3],"shadow_extent":30},
  "core.rng":{"seed":7},
  "behavior.program":{
   "variables":{"kills":0,"hero_alive":true},
   "events":{"enemy_down":{"fields":{"agent":"text"}},"hero_down":{"fields":{}}},
   "rules":[
    {"id":"count-kill","event":"enemy_down","actions":[{"kind":"add","variable":"kills","value":{"kind":"literal","value":1}}]},
    {"id":"victory","event":"enemy_down","when":{"kind":"ge","left":{"kind":"variable","id":"kills"},"right":{"kind":"literal","value":6}},"actions":[{"kind":"end","ending":"victory"}]},
    {"id":"defeat","event":"hero_down","actions":[{"kind":"set","variable":"hero_alive","value":{"kind":"literal","value":false}},{"kind":"end","ending":"defeat"}]}
   ]
  },
  "fsm.machines":{"machines":{
   "hero":{
    "initial":"hunt",
    "states":{
     "hunt":{"action":{"kind":"move_toward","tag":"enemy","speed":3.5,"stop_within":1.2}},
     "strike":{"action":{"kind":"attack","tag":"enemy","range":1.6,"damage":20,"interval_ticks":30}},
     "down":{"action":{"kind":"stop"},"emit":"hero_down"}
    },
    "transitions":[
     {"from":"*","to":"down","when":{"kind":"health_below","value":1}},
     {"from":"hunt","to":"strike","when":{"kind":"near","tag":"enemy","within":1.5}},
     {"from":"strike","to":"hunt","when":{"kind":"far","tag":"enemy","beyond":1.6}}
    ]
   },
   "grunt":{
    "initial":"idle",
    "states":{
     "idle":{"action":{"kind":"stop"}},
     "chase":{"action":{"kind":"move_toward","tag":"hero","speed":1.5,"stop_within":1.2}},
     "attack":{"action":{"kind":"attack","tag":"hero","range":1.6,"damage":3,"interval_ticks":60}},
     "dead":{"action":{"kind":"stop"},"emit":"enemy_down"}
    },
    "transitions":[
     {"from":"*","to":"dead","when":{"kind":"health_below","value":1}},
     {"from":"idle","to":"chase","when":{"kind":"near","tag":"hero","within":10}},
     {"from":"chase","to":"attack","when":{"kind":"near","tag":"hero","within":1.5}},
     {"from":"attack","to":"chase","when":{"kind":"far","tag":"hero","beyond":1.6}}
    ]
   }
  }}
 }
}
